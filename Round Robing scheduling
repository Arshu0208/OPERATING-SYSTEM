#include <stdio.h>

struct Process {
    int pid, bt, wt, tat, rem_bt;
};

void findWaitingTime(struct Process proc[], int n, int quantum) {
    int t = 0, done;
    do {
        done = 1;
        for (int i = 0; i < n; i++) {
            if (proc[i].rem_bt > 0) {
                done = 0;
                if (proc[i].rem_bt > quantum) {
                    t += quantum;
                    proc[i].rem_bt -= quantum;
                } else {
                    t += proc[i].rem_bt;
                    proc[i].wt = t - proc[i].bt;
                    proc[i].rem_bt = 0;
                }
            }
        }
    } while (!done);
}

void findTurnAroundTime(struct Process proc[], int n) {
    for (int i = 0; i < n; i++)
        proc[i].tat = proc[i].bt + proc[i].wt;
}

void roundRobin(struct Process proc[], int n, int quantum) {
    findWaitingTime(proc, n, quantum);
    findTurnAroundTime(proc, n);
    
    printf("PID  BT  WT  TAT\n");
    for (int i = 0; i < n; i++)
        printf("%d    %d   %d   %d\n", proc[i].pid, proc[i].bt, proc[i].wt, proc[i].tat);
}

int main() {
    int n, quantum;
    printf("Enter number of processes: ");
    scanf("%d", &n);
    struct Process proc[n];
    printf("Enter burst time for each process:\n");
    for (int i = 0; i < n; i++) {
        proc[i].pid = i + 1;
        scanf("%d", &proc[i].bt);
        proc[i].rem_bt = proc[i].bt;
    }
    printf("Enter time quantum: ");
    scanf("%d", &quantum);

    roundRobin(proc, n, quantum);
    return 0;
}
